<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <!--
    The Dalamud SDK supplies all framework references (Dalamud, ImGui bindings,
    FFXIVClientStructs, InteropGenerator, Newtonsoft) and generates the packaged
    manifest from the metadata below — so no manual <Reference> items and no
    separate CraftCast.json are needed.
  -->

  <PropertyGroup>
    <!-- Bump this to ship an update through the plugin repo: Dalamud compares
         AssemblyVersion in pluginmaster.json to decide when to offer updates. -->
    <AssemblyVersion>3.1.1.0</AssemblyVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <Author>wirumn</Author>
    <Name>CraftCast</Name>
    <Punchline>Bridges live FFXIV crafting state to a web solver over a local WebSocket.</Punchline>
    <Description>Reads the active craft condition, step, your stats, and the recipe's constraints each framework tick, broadcasts them over a local WebSocket (127.0.0.1:8014) to a paired userscript, and renders the solver's suggested next action as a borderless overlay anchored to the Synthesis window.</Description>
    <RepoUrl>https://github.com/wirumn/CraftCast</RepoUrl>
    <Tags>crafting;overlay;websocket;solver</Tags>
    <AcceptsFeedback>false</AcceptsFeedback>
  </PropertyGroup>

</Project>
